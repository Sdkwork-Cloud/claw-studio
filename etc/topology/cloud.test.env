# Bootstrap profile cloud.test — replace with application-specific values.
SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
SDKWORK_AGENTSTUDIO_ENVIRONMENT=test
SDKWORK_AGENTSTUDIO_PROFILE_ID=cloud.test
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://agentstudio-test.sdkwork.com
# Cloud realtime WebSocket rides the platform api edge — the same base domain
# as the SDK base URL — per the sdkwork-im aligned convention (the im-* / app
# web ingress edge does not terminate WebSocket upgrades).
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-test.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-test.sdkwork.com
SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AGENTSTUDIO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

