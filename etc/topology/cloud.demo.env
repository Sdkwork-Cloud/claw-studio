# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_agentstudio_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_agentstudio_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
SDKWORK_AGENTSTUDIO_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_AGENTSTUDIO_PROFILE_ID=cloud.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AGENTSTUDIO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

VITE_SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_AGENTSTUDIO_RUNTIME_TARGET=browser
SDKWORK_AGENTSTUDIO_ACCELERATOR_PROFILE=cpu


