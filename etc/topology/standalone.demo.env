# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_agentstudio_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_agentstudio_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=standalone
SDKWORK_AGENTSTUDIO_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_AGENTSTUDIO_PROFILE_ID=standalone.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AGENTSTUDIO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18797
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18797
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18797

VITE_SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18797
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18797

CLAW_SERVER_HOST=127.0.0.1
CLAW_SERVER_PORT=18797
SDKWORK_AGENTSTUDIO_RUNTIME_TARGET=desktop
SDKWORK_AGENTSTUDIO_ACCELERATOR_PROFILE=cpu


