        "development": {
          "httpHosts": [
            "api-dev.sdkwork.com",
            "api-dev.birdcoder.com",
            "api-dev.dtupay.com",
            "api-dev.sdkwork.cn",
            "api-dev.birdcoder.cn",
            "api-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "api-test.sdkwork.com",
            "api-test.birdcoder.com",
            "api-test.dtupay.com",
            "api-test.sdkwork.cn",
            "api-test.birdcoder.cn",
            "api-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "api-staging.sdkwork.com",
            "api-staging.birdcoder.com",
            "api-staging.dtupay.com",
            "api-staging.sdkwork.cn",
            "api-staging.birdcoder.cn",
            "api-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "api.sdkwork.com",
        "api.birdcoder.com",
        "api.dtupay.com",
        "api.sdkwork.cn",
        "api.birdcoder.cn",
        "api.dtupay.cn"
      ]
    },
    "application.app-http": {
      "httpHost": "agentstudio-app.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "agentstudio-app-dev.sdkwork.com",
            "agentstudio-app-dev.birdcoder.com",
            "agentstudio-app-dev.dtupay.com",
            "agentstudio-app-dev.sdkwork.cn",
            "agentstudio-app-dev.birdcoder.cn",
            "agentstudio-app-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "agentstudio-app-test.sdkwork.com",
            "agentstudio-app-test.birdcoder.com",
            "agentstudio-app-test.dtupay.com",
            "agentstudio-app-test.sdkwork.cn",
            "agentstudio-app-test.birdcoder.cn",
            "agentstudio-app-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "agentstudio-app-staging.sdkwork.com",
            "agentstudio-app-staging.birdcoder.com",
            "agentstudio-app-staging.dtupay.com",
            "agentstudio-app-staging.sdkwork.cn",
            "agentstudio-app-staging.birdcoder.cn",
            "agentstudio-app-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "agentstudio-app.sdkwork.com",
        "agentstudio-app.birdcoder.com",
        "agentstudio-app.dtupay.com",
        "agentstudio-app.sdkwork.cn",
        "agentstudio-app.birdcoder.cn",
        "agentstudio-app.dtupay.cn"
      ]
    },
    "application.backend-http": {
      "httpHost": "agentstudio-admin.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "agentstudio-admin-dev.sdkwork.com",
            "agentstudio-admin-dev.birdcoder.com",
            "agentstudio-admin-dev.dtupay.com",
            "agentstudio-admin-dev.sdkwork.cn",
            "agentstudio-admin-dev.birdcoder.cn",
            "agentstudio-admin-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "agentstudio-admin-test.sdkwork.com",
            "agentstudio-admin-test.birdcoder.com",
            "agentstudio-admin-test.dtupay.com",
            "agentstudio-admin-test.sdkwork.cn",
            "agentstudio-admin-test.birdcoder.cn",
            "agentstudio-admin-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "agentstudio-admin-staging.sdkwork.com",
            "agentstudio-admin-staging.birdcoder.com",
            "agentstudio-admin-staging.dtupay.com",
            "agentstudio-admin-staging.sdkwork.cn",
            "agentstudio-admin-staging.birdcoder.cn",
            "agentstudio-admin-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "agentstudio-admin.sdkwork.com",
        "agentstudio-admin.birdcoder.com",
        "agentstudio-admin.dtupay.com",
        "agentstudio-admin.sdkwork.cn",
        "agentstudio-admin.birdcoder.cn",
        "agentstudio-admin.dtupay.cn"
      ]
    }
  },
  "components": {
    "applicationServer": {
      "package": "@sdkwork/agentstudio-pc-server",
      "script": "dev"
    },
    "browserClient": {
      "package": "@sdkwork/agentstudio-pc-web",
      "script": "dev"
    },
    "desktopClient": {
      "package": "@sdkwork/agentstudio-pc-desktop",
      "script": "dev:desktop"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "agentstudio-standalone-gateway",
            "role": "api-standalone-gateway",
            "package": "@sdkwork/agentstudio-pc-server",
            "script": "dev",
            "required": true
          },
          {
            "id": "agentstudio-browser",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-web",
            "script": "dev",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ],
            "required": true
          },
          {
            "id": "agentstudio-desktop",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-desktop",
            "script": "dev:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [
          {
            "id": "agentstudio-browser",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-web",
            "script": "dev",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ],
            "required": true
          },
          {
            "id": "agentstudio-desktop",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-desktop",
            "script": "dev:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.test": {
        "processes": [
          {
            "id": "agentstudio-standalone-gateway",
            "role": "api-standalone-gateway",
            "package": "@sdkwork/agentstudio-pc-server",
            "script": "dev",
            "required": true
          },
          {
            "id": "agentstudio-browser",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-web",
            "script": "dev",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ],
            "required": true
          },
          {
            "id": "agentstudio-desktop",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-desktop",
            "script": "dev:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.test": {
        "processes": [
          {
            "id": "agentstudio-browser",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-web",
            "script": "dev",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ],
            "required": true
          },
          {
            "id": "agentstudio-desktop",
            "role": "client",
            "package": "@sdkwork/agentstudio-pc-desktop",
            "script": "dev:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [],
        "healthSurfaces": []
      }
    }
  },
  "retired": {
    "profileFiles": [
      "deploy/profiles/standalone.development.env",
      "deploy/profiles/cloud.staging.env",
      "deploy/profiles/cloud.production.env"
    ]
  },
  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "container-noarch-cloud-container-config-bundle-tar-gz",
        "profile": "container",
        "platform": "container",
        "architecture": "noarch",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "outputGlob": "dist/cloud-config/sdkwork-agentstudio-api-gateway-config-*.tar.gz",
        "deploymentProfile": "cloud",
        "runtimeTarget": "container",
        "variant": "config-bundle"
      }
    ]
  }
}
